# Server configuration template; real values must stay in ignored .env files.
NODE_ENV=development
PORT=3002
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=qingyang_dev_m01
DB_USER=qingyang_m01
DB_PASSWORD=
DB_TIMEZONE=+00:00
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=轻养健康
EMAIL_CODE_TTL_SECONDS=300
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
# Generate independently using a cryptographic RNG; never reuse SMTP authorization.
AUTH_HMAC_KEY=
AUTH_ENCRYPTION_KEY=
APP_ORIGIN=http://127.0.0.1:3001
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
# Required for production email endpoints; trusted ingress overwrites X-Real-IP and this token.
TRUSTED_PROXY_TOKEN=
