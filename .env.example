# Server configuration template; real values must stay in ignored .env files.
NODE_ENV=development
PORT=3002
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=qingyang_dev_m01
DB_USER=qingyang_m01
DB_PASSWORD=
DB_TIMEZONE=+00:00
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=轻养健康
EMAIL_CODE_TTL_SECONDS=300
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
# Generate independently using a cryptographic RNG; never reuse SMTP authorization.
AUTH_HMAC_KEY=
AUTH_ENCRYPTION_KEY=
APP_ORIGIN=http://127.0.0.1:3001
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
# Required for production email endpoints; trusted ingress overwrites X-Real-IP and this token.
TRUSTED_PROXY_TOKEN=

# M03 online food-photo recognition (server only; never use NEXT_PUBLIC_*).
# Used by the integrated M03 online VisionPort; absent key disables recognition.
M03_VISION_PROVIDER=qianwen-online
M03_VISION_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
M03_VISION_MODEL=qwen3-vl-plus
DASHSCOPE_API_KEY=
M03_VISION_TIMEOUT_MS=60000
# Server-only Amap MCP key; absent key disables real nearby search.
# The current adapter uses zero cache and does not allow new favorites.
M03_AMAP_API_KEY=
