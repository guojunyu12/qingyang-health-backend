{
  "name": "qingyang-health-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "migrate": "node --import tsx scripts/migrate.ts",
    "worker": "node --import tsx src/worker.ts",
    "media:backfill": "node --import tsx scripts/backfill-media.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "bullmq": "^6.3.17",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.7",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
